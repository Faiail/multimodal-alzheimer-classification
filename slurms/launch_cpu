#!/bin/bash

#SBATCH -A IscrC_BRIDGEV
#SBATCH -p lrd_all_serial
#SBATCH --qos normal
#SBATCH --time 04:00:00
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=0
#SBATCH --job-name=preprocess
#SBATCH --out=outs/preprocess.out
#SBATCH --err=outs/preprocess.out
#SBATCH --open-mode=append

# Automatically queue the next continuation job (triggered ONLY if this job times out)
STDOUT_PATH=$(scontrol show job "$SLURM_JOB_ID" | awk -F= '/StdOut=/{print $2}')
STDERR_PATH=$(scontrol show job "$SLURM_JOB_ID" | awk -F= '/StdErr=/{print $2}')

NEXT_JOB=$(sbatch --parsable \
    --dependency=afternotok:"$SLURM_JOB_ID" \
    --open-mode=append \
    --job-name="$SLURM_JOB_NAME" \
    -o "$STDOUT_PATH" \
    -e "$STDERR_PATH" \
    slurms/launch_cpu "$@")

srun ./slurms/exe "$@"
EXIT_CODE=$?

# If all volumes finished cleanly, cancel the unused continuation job
if [ $EXIT_CODE -eq 0 ] && [ -n "$NEXT_JOB" ]; then
    scancel "$NEXT_JOB"
fi
exit $EXIT_CODE


